{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RKDKCW Launcher",
  "version": "2.1.1",
  "identifier": "com.rkdkcw.launcher",
  "build": {
    "frontendDist": "../dist_frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RKDKCW Launcher",
        "url": "index.html",
        "width": 1240,
        "height": 760,
        "minWidth": 1020,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
